{
  "buildCommand": "npm run vercel-build",
  "crons": [
    { "path": "/api/cron/birthday-notifications", "schedule": "15 0 * * *" },
    { "path": "/api/cron/release-status-sync", "schedule": "25 1 * * *" },
    { "path": "/api/cron/direnote-release-sync", "schedule": "45 1 * * *" },
    { "path": "/api/cron/direnote-revenue-sync", "schedule": "55 1 2 * *" },
    { "path": "/api/cron/payment-reconciliation", "schedule": "35 1 * * *" },
    { "path": "/api/cron/draft-nudges", "schedule": "45 8 * * *" },
    { "path": "/api/cron/quarterly-payout-reset", "schedule": "10 1 * * *" }
  ],
  "build": {
    "env": {
      "VERCEL_SUPPORT_LARGE_FUNCTIONS": "1"
    }
  }
}

