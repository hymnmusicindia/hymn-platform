{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    ".next-dev-admin-local/types/**/*.ts",
    ".next-dev-enterprise/types/**/*.ts",
    ".next-dev-home/types/**/*.ts",
    ".next-dev-services/types/**/*.ts",
    ".next-dev-ui/types/**/*.ts",
    ".next/types/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "next-env.d.ts",
    ".next-dev-admin-local-test/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-direnote-virtual/types/**/*.ts",
    ".next-direnote-virtual/dev/types/**/*.ts",
    ".next-dev-landing/types/**/*.ts",
    ".next-dev-landing/dev/types/**/*.ts",
    ".next-studio-review/types/**/*.ts",
    ".next-studio-review/dev/types/**/*.ts",
    ".next-verify-manual-email/types/**/*.ts",
    ".next-verify-manual-email/dev/types/**/*.ts",
    ".next-sidebar-dev/types/**/*.ts",
    ".next-sidebar-dev/dev/types/**/*.ts",
    ".next-team-browser/types/**/*.ts",
    ".next-team-browser/dev/types/**/*.ts",
    ".next-admin-os-browser/types/**/*.ts",
    ".next-admin-os-browser/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
