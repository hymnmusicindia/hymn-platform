{
  "name": "hymn-platform",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build",
    "build:release": "prisma generate && tsx scripts/deploy-production-migrations.ts && next build",
    "vercel-build": "prisma generate && tsx scripts/verify-direnote-schema.ts --production-build && next build",
    "deploy:release": "tsx scripts/deploy-production-migrations.ts",
    "start": "tsx scripts/start-production.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:backfill:spotify": "tsx scripts/backfill-legacy-spotify.ts",
    "db:migrate:deploy": "tsx scripts/deploy-production-migrations.ts",
    "db:verify:production": "tsx scripts/verify-production-database-target.ts",
    "test": "npm run test:performance-execution && npm run test:first-release && npm run test:direnote-contract && npm run test:producer-lifecycle && npm run test:analytics && npm run test:migration-safety && npm run test:razorpay && npm run test:subscriptions && npm run test:payment-enforcement && npm run test:storage && npm run test:release-status && npm run test:distribution-idempotency && npm run test:payout && npm run test:managed-services",
    "test:first-release": "tsx scripts/verify-first-release-funnel.ts && tsx scripts/verify-artist-profile-validation.ts",
    "test:distribution-pricing": "tsx scripts/verify-distribution-pricing.ts",
    "test:growth": "tsx scripts/verify-growth-domain.ts",
    "test:growth-integration": "tsx scripts/verify-growth-isolated.ts",
    "test:payout": "tsx scripts/verify-payout-domain.ts",
    "test:analytics": "tsx scripts/verify-analytics-domain.ts",
    "test:migration-safety": "tsx scripts/verify-migration-safety.ts",
    "test:audit-log-schema": "tsx scripts/verify-audit-log-schema.ts",
    "test:postgres-canonical": "tsx scripts/verify-postgres-canonical.ts",
    "test:razorpay": "tsx scripts/verify-razorpay-signatures.ts",
    "test:subscriptions": "tsx scripts/verify-razorpay-subscriptions.ts",
    "test:payment-enforcement": "tsx scripts/verify-distribution-payment-enforcement.ts",
    "test:payments-integration": "tsx scripts/verify-payment-webhooks-integration.ts",
    "test:referrals-integration": "tsx scripts/verify-referral-integration.ts",
    "test:storage": "tsx scripts/verify-private-storage.ts && tsx scripts/verify-upload-storage.ts && tsx scripts/verify-media-integrity.ts",
    "test:storage-integration": "tsx scripts/verify-private-storage-integration.ts",
    "test:admin-marketplace": "tsx scripts/verify-admin-marketplace.ts",
    "test:release-status": "tsx scripts/verify-release-status.ts && tsx scripts/verify-release-input-rules.ts",
    "test:draft-deletion": "node --conditions=react-server --import tsx scripts/verify-draft-deletion.ts",
    "test:release-status-integration": "tsx scripts/verify-release-status-integration.ts",
    "test:change-requests-integration": "tsx scripts/verify-release-change-requests-integration.ts",
    "test:royalty-integration": "tsx scripts/verify-royalty-ledger-integration.ts",
    "test:payout-kyc-integration": "tsx scripts/verify-payout-kyc-integration.ts",
    "test:admin-controls-integration": "tsx scripts/verify-admin-controls-integration.ts",
    "test:distribution-idempotency": "tsx scripts/verify-distribution-idempotency.ts",
    "test:direnote-integration": "node --conditions=react-server --import tsx scripts/verify-direnote-integration.ts",
    "test:direnote-contract": "tsx scripts/verify-direnote-contract.ts && tsx scripts/verify-provider-failures.ts",
    "test:direnote-fields": "tsx scripts/verify-direnote-field-mapping.ts",
    "test:direnote-corrections": "node --conditions=react-server --import tsx scripts/verify-direnote-corrections.ts",
    "test:direnote-virtual": "node --import tsx scripts/verify-direnote-virtual.ts",
    "test:direnote-e2e": "node --import tsx scripts/verify-direnote-virtual.ts --build",
    "test:managed-services": "tsx scripts/verify-managed-services.ts",
    "test:producer-lifecycle": "tsx scripts/verify-producer-lifecycle.ts && node --conditions=react-server --import tsx scripts/verify-contributor-sync.ts",
    "test:performance-execution": "tsx scripts/verify-performance-execution.ts",
    "test:managed-services-integration": "tsx scripts/verify-managed-services-integration.ts",
    "audit:producer-identities": "tsx scripts/audit-producer-identity-migration.ts",
    "audit:release-storage": "tsx scripts/audit-release-storage-reconciliation.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.8.0",
    "axios": "^1.18.0",
    "bcrypt": "^6.0.0",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.38.0",
    "google-auth-library": "^10.7.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.511.0",
    "mysql2": "3.24.4",
    "next": "16.3.6",
    "razorpay": "^2.9.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^6.18.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.4",
    "tesseract.js": "^7.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "autoprefixer": "^10.4.21",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "postcss": "8.5.28",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "ts-api-utils": "^2.5.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "sharp": "0.35.4",
    "next": {
      "postcss": "8.5.28"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "readdir-glob": {
      "brace-expansion": "2.1.4"
    },
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
