NEXT_PUBLIC_APP_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth
JWT_SECRET=change-me-change-me-change-me
ADMIN_JWT_SECRET=use-a-different-high-entropy-secret
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
ADMIN_GOOGLE_EMAILS=admin@hymnmusic.in

# Database: production uses PostgreSQL + Prisma.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/hymn?schema=public

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Uploads: local storage works for development; use a bucket in production.
STORAGE_ROOT=./public/uploads
GCS_BUCKET=
GCS_SIGNED_URL_TTL_SECONDS=900

# Spotify admin integrations
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/admin/spotify/callback

# DireNote DNM API v2.2: keep client id and PIN server-side only.
# Do not expose any of these with NEXT_PUBLIC_.
DIRENOTE_INGEST_ENDPOINT=https://api.direnotemedia.com/ingest_content
DIRENOTE_RELEASE_INFORMATION_ENDPOINT=https://api.direnotemedia.com/check_release_status
DIRENOTE_REVENUE_REPORT_ENDPOINT=https://api.direnotemedia.com/check_revenue_report
AUTO_MARK_LIVE_AFTER_RELEASE_DATE=false
DIRENOTE_CLIENT_ID=
DIRENOTE_API_PIN=
DIRENOTE_RELEASE_SYNC_ENABLED=true
# Revenue sync is opt-in until a finance administrator verifies the account.
DIRENOTE_REVENUE_SYNC_ENABLED=false
DIRENOTE_REVENUE_SYNC_ACTOR_ID=

# Splits and payout automation
# Generate a high-entropy secret; changing it makes stored payout credentials unreadable.
PAYOUT_ENCRYPTION_KEY=
CRON_SECRET=
MINIMUM_PAYOUT_USD=105
FX_RATE_REFRESH_HOURS=24
FX_RATE_PROVIDER=Frankfurter
FX_RATE_PROVIDER_URL=https://api.frankfurter.app/latest?from=USD&to=INR
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
PAYOUT_CYCLE=quarterly
ALLOW_PAYOUT_REQUESTS_DURING_OPEN_QUARTER=false
BYPASS_DISTRIBUTION_PAYMENT=false

# vercel trigger
EMAIL_PROVIDER=resend
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM="HYMN Music <updates@yourdomain.com>"
EMAIL_REPLY_TO="support@yourdomain.com"
APP_URL="http://localhost:3000"
# Absolute durable directory outside the public web root; required for private assets in self-hosted production.
PRIVATE_STORAGE_ROOT=D:\\hymn-private-storage
