NEXT_PUBLIC_APP_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000

# Auth
JWT_SECRET=change-me-change-me-change-me
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
ADMIN_GOOGLE_EMAILS=admin@hymnmusic.in

# Database: production uses PostgreSQL + Prisma.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/hymn?schema=public

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Uploads: local storage works for development; use a bucket in production.
STORAGE_ROOT=./public/uploads
GCS_BUCKET=
GCS_SIGNED_URL_TTL_SECONDS=900

# Distributor API: keep these server-side only.
DISTRIBUTOR_CLIENT_ID=
DISTRIBUTOR_API_PIN=
DISTRIBUTOR_RELEASE_ENDPOINT=
DISTRIBUTOR_STATUS_ENDPOINT=

# Spotify admin integrations
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/admin/spotify/callback
BYPASS_DISTRIBUTION_PAYMENT=false
