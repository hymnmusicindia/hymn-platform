generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  PRODUCER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  PAUSED
  UNDER_REVIEW
  SUSPENDED
  DELETION_SCHEDULED
  BANNED
}

enum ProducerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReleaseStatus {
  DRAFT
  AWAITING_PAYMENT
  SUBMITTED
  IN_QUEUE
  IN_QC_QUEUE
  UNDER_REVIEW
  CHANGES_REQUESTED
  RESUBMITTED
  APPROVED
  QUEUED_FOR_DISTRIBUTION
  SUBMITTING_TO_DISTRIBUTOR
  SENT_TO_DISTRIBUTOR
  DISTRIBUTOR_PROCESSING
  DISTRIBUTOR_CHANGES_REQUIRED
  SCHEDULED
  PROCESSING
  AWAITING_LIVE_CONFIRMATION
  PARTIALLY_LIVE
  DELIVERED
  SENT
  LIVE
  DISTRIBUTED
  REJECTED
  FAILED
  DELIVERY_FAILED
  TAKEDOWN_REQUESTED
  TAKEDOWN_PROCESSING
  TAKEN_DOWN
  ARCHIVED
}

enum ReleaseSource {
  CUSTOMER_SUBMISSION
  ADMIN_MANUAL
  DIRENOTE_SYNC
  MIGRATED
}

enum UploadKind {
  AUDIO
  ARTWORK
  BEAT
  DOCUMENT
  SAMPLE
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum PayoutStatus {
  PENDING
  APPROVED
  PAID
  FAILED
}

enum PayoutRequestMethod {
  UPI
  BANK
}

enum PayoutRequestStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  PROCESSING
  PAID
  FAILED
  REJECTED
  CANCELLED
}

enum StudioOrderStatus {
  DRAFT
  AWAITING_PAYMENT
  PAID
  AWAITING_ENGINEER_ACCEPTANCE
  ACCEPTED
  AWAITING_SOURCE_FILES
  IN_PROGRESS
  DELIVERED
  REVISION_PAYMENT_REQUIRED
  REVISION_REQUESTED
  CUSTOMER_APPROVED
  COMPLETED
  CANCELLED
  REFUND_PENDING
  REFUNDED
  DISPUTED
  EXPIRED
}

enum StudioPaymentPurpose {
  INITIAL_ORDER
  ADDITIONAL_REVISION
  AMENDMENT
  REFUND
}

model User {
  teamMemberships TeamMember[]
  clientCards TeamClient[]
  studioTipsEnabled Boolean @default(true) @map("studio_tips_enabled")
  studioVouches StudioVouch[]
  studioShowcaseCredits StudioShowcase[] @relation("ShowcaseArtist")
  studioConsultations StudioConsultation[]
  studioTrustReports StudioTrustReport[]
  referralMessages ReferralMessage[]
  referralMailJobs ReferralMailJob[]
  routeLinkedAccount            RouteLinkedAccount?
  routeTransfers                RouteTransfer[]
  handle                        UserHandle?
  handleReservations            UserHandleReservation[]
  id                            Int                                 @id @default(autoincrement())
  googleId                      String                              @unique @map("google_id")
  name                          String
  email                         String                              @unique
  passwordHash                  String?                             @map("password_hash")
  avatar                        String?
  presenceStatus                String                              @default("online") @map("presence_status")
  role                          UserRole                            @default(CUSTOMER)
  status                        AccountStatus                       @default(ACTIVE)
  statusReason                  String?                             @map("status_reason")
  statusChangedAt               DateTime?                           @map("status_changed_at")
  deletionScheduledAt           DateTime?                           @map("deletion_scheduled_at")
  appealRequestedAt             DateTime?                           @map("appeal_requested_at")
  appealMessage                 String?                             @map("appeal_message")
  onboardingDone                Boolean                             @default(false) @map("onboarding_done")
  mobile                        String?
  contactEmail                  String?                             @map("contact_email")
  dateOfBirth                   DateTime?                           @map("date_of_birth") @db.Date
  preferredLanguage             String                              @default("en") @map("preferred_language")
  onboardingPurpose             String?                             @map("onboarding_purpose")
  onboardingUserType            String?                             @map("onboarding_user_type")
  referralSource                String?                             @map("referral_source")
  onboardingReferralCode        String?                             @map("onboarding_referral_code")
  referralPromptCompletedAt     DateTime?                           @map("referral_prompt_completed_at")
  onboardingCompletedAt         DateTime?                           @map("onboarding_completed_at")
  onboardingPreferences         Json?                               @map("onboarding_preferences")
  referralCode                  String?                             @unique @map("referral_code")
  referralCredits               Int                                 @default(0) @map("referral_credits")
  referredById                  Int?                                @map("referred_by")
  firstPaymentRewarded          Boolean                             @default(false) @map("first_payment_rewarded")
  createdAt                     DateTime                            @default(now()) @map("created_at")
  updatedAt                     DateTime                            @updatedAt @map("updated_at")
  sessions                      Session[]
  applications                  ProducerApplication[]               @relation("ApplicantApplications")
  reviewedApps                  ProducerApplication[]               @relation("ApplicationReviewer")
  engineerApplication          EngineerApplication?                 @relation("EngineerApplicant")
  reviewedEngineerApplications EngineerApplication[]                @relation("EngineerApplicationReviewer")
  releases                      Release[]
  ownedManualReleases           Release[]                           @relation("ManualReleaseOwner")
  assignedManualReleases        Release[]                           @relation("ManualReleaseAssigner")
  uploads                       Upload[]
  royalties                     Royalty[]
  payouts                       Payout[]
  payoutRequests                PayoutRequest[]
  payoutBalance                 ArtistPayoutBalance?
  royaltyLineItems              RoyaltyLineItem[]
  notifications                 Notification[]
  emailLogs                     EmailLog[]
  supportTickets                SupportTicket[]
  auditLogs                     AuditLog[]
  subscription                  Subscription?
  referredBy                    User?                               @relation("UserReferrals", fields: [referredById], references: [id])
  referrals                     User[]                              @relation("UserReferrals")
  sentReferrals                 Referral[]                          @relation("ReferralOwner")
  receivedReferral              Referral?                           @relation("ReferralRecipient")
  creditLedgerEntries           CreditLedgerEntry[]
  referralVisits                ReferralVisit[]
  referralCommissionPayouts     ReferralCommissionPayout[]
  beats                         Beat[]
  producerProfile               ProducerProfile?
  artistCards                   ArtistCard[]
  ownedSplitRecords             SplitRecord[]                       @relation("SplitOwner")
  splitRecipients               SplitRecipient[]                    @relation("SplitRecipientUser")
  payoutCredential              PayoutCredential?
  splitEarnings                 SplitEarningLineItem[]
  walletTransactions            WalletTransaction[]
  producerSales                 BeatSale[]                          @relation("ProducerBeatSales")
  purchasedBeatSales            BeatSale[]                          @relation("BuyerBeatSales")
  quarterCarryForwards          QuarterCarryForward[]
  storedAssets                  StoredAsset[]
  uploadSessions                UploadSession[]
  royaltyStatements             RoyaltyStatement[]
  royaltyImportJobs             RoyaltyImportJob[]
  royaltyAllocations            RoyaltyAllocation[]
  adminMembership               AdminMembership?
  managedServiceRequests        ManagedServiceRequest[]
  distributionOrders            DistributionOrder[]
  checkoutOrders                CheckoutOrder[]
  couponRedemptions             CouponRedemption[]
  beatPurchases                 BeatPurchase[]
  financialAdjustmentSubjects   FinancialAdjustment[]               @relation("FinancialAdjustmentSubject")
  requestedFinancialAdjustments FinancialAdjustment[]               @relation("FinancialAdjustmentRequester")
  approvedFinancialAdjustments  FinancialAdjustment[]               @relation("FinancialAdjustmentApprover")
  direNoteDiscrepanciesResolved DireNoteReconciliationDiscrepancy[] @relation("DireNoteDiscrepancyResolver")
  promotionRedemptions          PromotionRedemption[]
  purchaseReviews               PurchaseReview[]                    @relation("ReviewAuthor")
  moderatedPurchaseReviews      PurchaseReview[]                    @relation("ReviewModerator")
  claimedContributorParty       ContributorParty?                   @relation("ClaimedContributorParty")
  createdContributorParties     ContributorParty[]                  @relation("ContributorPartyCreator")
  contributorInvitationsSent    ContributorInvitation[]             @relation("ContributorInvitationSender")
  contributorInvitationsClaimed ContributorInvitation[]             @relation("ContributorInvitationClaimer")
  studioOrders                  StudioServiceOrder[]                @relation("StudioCustomer")
  studioMessages                StudioMessage[]                     @relation("StudioMessageSender")
  studioFilesUploaded           StudioFile[]                        @relation("StudioFileUploader")
  studioRevisionsRequested      StudioRevision[]                    @relation("StudioRevisionRequester")
  studioAmendmentsProposed      StudioAmendment[]                   @relation("StudioAmendmentProposer")
  studioStatusEvents            StudioOrderStatusEvent[]            @relation("StudioStatusActor")
  studioReviews                 StudioReview[]                      @relation("StudioReviewAuthor")
  acquisitionLeads              AcquisitionLead[]
  acquisitionRevenueEvidence    AcquisitionRevenueEvidence[]
  acquisitionCommissionsReceived AcquisitionCommission[]

  @@index([role])
  @@index([email])
  playlistReviewListings PlaylistReviewListing[] @relation("PlaylistReviewCurator")
  playlistReviewRequests PlaylistReviewRequest[] @relation("PlaylistReviewCustomer")
  playlistReviewMail PlaylistReviewMail[] @relation("PlaylistReviewRecipient")
  @@map("users")
}

model Session {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model ProducerApplication {
  id              Int                       @id @default(autoincrement())
  userId          Int                       @map("user_id")
  producerName    String                    @map("producer_name")
  genre           String
  portfolioLinks  String[]                  @default([]) @map("portfolio_links")
  instagram       String?
  youtube         String?
  soundcloud      String?
  spotify         String?
  yearsExperience Int                       @map("years_experience")
  pricing         String
  sampleBeats     String[]                  @default([]) @map("sample_beats")
  bio             String
  status          ProducerApplicationStatus @default(PENDING)
  internalNotes   String?                   @map("internal_notes")
  reviewedById    Int?                      @map("reviewed_by_id")
  reviewedAt      DateTime?                 @map("reviewed_at")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")
  user            User                      @relation("ApplicantApplications", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy      User?                     @relation("ApplicationReviewer", fields: [reviewedById], references: [id])

  @@index([status, createdAt])
  @@map("producer_applications")
}

model Release {
  id                          Int                                 @id @default(autoincrement())
  userId                      Int                                 @map("user_id")
  ownerUserId                 Int?                                @map("owner_user_id")
  artistProfileId             Int?                                @map("artist_profile_id")
  releaseSource               ReleaseSource                       @default(CUSTOMER_SUBMISSION) @map("release_source")
  customerEditable            Boolean                             @default(true) @map("customer_editable")
  assignedByAdminId           Int?                                @map("assigned_by_admin_id")
  assignedAt                  DateTime?                           @map("assigned_at")
  archivedAt                  DateTime?                           @map("archived_at")
  title                       String
  artistName                  String                              @map("artist_name")
  genre                       String
  collaborators               String[]                            @default([])
  producer                    String?
  bpm                         Int?
  explicit                    Boolean                             @default(false)
  releaseDate                 DateTime                            @map("release_date")
  status                      ReleaseStatus                       @default(DRAFT)
  distributorReleaseId        String?                             @map("distributor_release_id")
  direNoteStatus              String?                             @map("direnote_status")
  direNoteLastSyncedAt        DateTime?                           @map("direnote_last_synced_at")
  direNoteLastAttemptedAt     DateTime?                           @map("direnote_last_attempted_at")
  direNoteSyncError           String?                             @map("direnote_sync_error")
  upc                         String?                             @map("upc_code")
  rejectionReason             String?                             @map("rejection_reason")
  correctionReason            String?                             @map("correction_reason")
  reviewIssues                Json?                               @map("review_issues")
  adminInternalNote           String?                             @map("admin_internal_note")
  reviewedAt                  DateTime?                           @map("reviewed_at")
  reviewedBy                  String?                             @map("reviewed_by")
  releaseType                 String?                             @map("release_type")
  artworkUrl                  String?                             @map("artwork_url")
  audioUrl                    String?                             @map("audio_url")
  paymentStatus               String?                             @default("pending") @map("payment_status")
  metadata                    Json?
  draftCompletionPercent      Int                                 @default(0) @map("draft_completion_percent")
  lastEditedAt                DateTime?                           @map("last_edited_at")
  missingFields               Json?                               @map("missing_fields")
  reviewConfirmedAt           DateTime?                           @map("review_confirmed_at")
  reviewConfirmedBy           Int?                                @map("review_confirmed_by")
  reviewMetadataHash          String?                             @map("review_metadata_hash")
  createdAt                   DateTime                            @default(now()) @map("created_at")
  updatedAt                   DateTime                            @updatedAt @map("updated_at")
  version                     Int                                 @default(1)
  user                        User                                @relation(fields: [userId], references: [id], onDelete: Cascade)
  owner                       User?                               @relation("ManualReleaseOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  artistProfile               ArtistCard?                         @relation(fields: [artistProfileId], references: [id], onDelete: SetNull)
  assignedByAdmin             User?                               @relation("ManualReleaseAssigner", fields: [assignedByAdminId], references: [id], onDelete: SetNull)
  ownershipHistory            ReleaseOwnershipHistory[]
  tracks                      Track[]
  uploads                     Upload[]
  analytics                   Analytics[]
  royalties                   Royalty[]
  royaltyLineItems            RoyaltyLineItem[]
  distributionQueueEntry      DistributionQueueEntry?
  splitRecords                SplitRecord[]
  splitRecipients             SplitRecipient[]
  splitEarnings               SplitEarningLineItem[]
  direNoteLogs                DireNoteLog[]
  storedAssets                StoredAsset[]
  audioAssetLinks             ReleaseAssetLink[]
  uploadSessions              UploadSession[]
  statusTransitions           ReleaseStatusTransition[]
  distributionSubmissions     DistributionSubmissionAttempt[]
  changeRequests              ReleaseChangeRequest[]
  managedServiceRequests      ManagedServiceRequest[]
  unmatchedRoyaltyRows        UnmatchedRoyaltyRow[]
  reconciliationDiscrepancies DireNoteReconciliationDiscrepancy[]
  promotionRedemptions        PromotionRedemption[]
  subscriptionUsage           SubscriptionReleaseUsage?
  distributionOrder           DistributionOrder?
  identifierHistory           ExternalIdentifierHistory[]
  studioReleaseHandoff        StudioReleaseHandoff?

  @@index([ownerUserId, status])
  @@index([releaseSource, archivedAt, createdAt])
  @@index([artistProfileId])
  @@index([status, createdAt])
  @@index([distributorReleaseId])
  @@index([upc])
  @@map("releases")
}

model Promotion {
  id             Int                   @id @default(autoincrement())
  code           String                @unique
  name           String
  product        String
  discountType   String                @map("discount_type")
  discountValue  Decimal               @map("discount_value") @db.Decimal(12, 2)
  active         Boolean               @default(true)
  startsAt       DateTime?             @map("starts_at")
  endsAt         DateTime?             @map("ends_at")
  maxRedemptions Int?                  @map("max_redemptions")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  redemptions    PromotionRedemption[]

  @@map("promotions")
}

model PromotionRedemption {
  id             Int       @id @default(autoincrement())
  promotionId    Int       @map("promotion_id")
  userId         Int       @map("user_id")
  releaseId      Int?      @map("release_id")
  originalAmount Decimal   @map("original_amount") @db.Decimal(12, 2)
  discountAmount Decimal   @map("discount_amount") @db.Decimal(12, 2)
  finalAmount    Decimal   @map("final_amount") @db.Decimal(12, 2)
  currency       String    @default("INR")
  status         String    @default("RESERVED")
  campaignSource Json?     @map("campaign_source")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  redeemedAt     DateTime? @map("redeemed_at")
  promotion      Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  user           User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  release        Release?  @relation(fields: [releaseId], references: [id], onDelete: Restrict)

  @@unique([promotionId, userId])
  @@index([status, createdAt])
  @@index([releaseId])
  @@map("promotion_redemptions")
}

model GrowthVisitor {
  id         String   @id
  userId     Int?     @map("user_id")
  firstTouch Json     @map("first_touch")
  lastTouch  Json     @map("last_touch")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@map("growth_visitors")
}

model GrowthEvent {
  id         String   @id @default(uuid())
  key        String   @unique
  event      String
  userId     Int?     @map("user_id")
  visitorId  String?  @map("visitor_id")
  source     String
  campaign   String?
  properties Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([event, createdAt])
  @@index([campaign, createdAt])
  @@index([userId, event])
  @@map("growth_events")
}

model MarketingCampaign {
  id          Int             @id @default(autoincrement())
  slug        String          @unique
  name        String
  channel     String
  status      String          @default("draft")
  landingPage String          @map("landing_page")
  source      String
  medium      String
  content     String          @default("")
  budgetCents Int             @default(0) @map("budget_cents")
  notes       String          @default("")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  spend       CampaignSpend[]

  @@map("marketing_campaigns")
}

model CampaignSpend {
  id          String            @id
  campaignId  Int               @map("campaign_id")
  amountCents Int               @map("amount_cents")
  spentAt     DateTime          @map("spent_at")
  note        String
  actorId     Int?              @map("actor_id")
  createdAt   DateTime          @default(now()) @map("created_at")
  campaign    MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  @@index([campaignId, spentAt])
  @@map("campaign_spend")
}

model GrowthLead {
  teamProspect TeamProspect?
  id          Int      @id @default(autoincrement())
  kind        String
  name        String
  email       String
  phone       String?
  company     String?
  interest    String
  message     String
  status      String   @default("new")
  userId      Int?     @map("user_id")
  visitorId   String?  @map("visitor_id")
  attribution Json?
  notes       String   @default("")
  assignedTo  Int?     @map("assigned_to")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([kind, status, createdAt])
  @@map("growth_leads")
}

model GrowthCommunicationPreference {
  userId    Int     @id @map("user_id")
  reminders Boolean @default(false)

  @@map("growth_communication_preferences")
}

model GrowthNudge {
  key       String   @id
  userId    Int      @map("user_id")
  releaseId Int      @map("release_id")
  stage     Int
  dueAt     DateTime @map("due_at")
  status    String   @default("pending")

  @@index([status, dueAt])
  @@map("growth_nudges")
}

model GrowthPartner {
  id        Int               @id @default(autoincrement())
  leadId    Int               @unique @map("lead_id")
  code      String            @unique
  name      String
  email     String
  status    String            @default("approved")
  createdAt DateTime          @default(now()) @map("created_at")
  referrals PartnerReferral[]

  @@map("growth_partners")
}

model PartnerReferral {
  id        Int            @id @default(autoincrement())
  partnerId Int            @map("partner_id")
  userId    Int            @unique @map("user_id")
  policy    Json
  createdAt DateTime       @default(now()) @map("created_at")
  partner   GrowthPartner  @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  reward    PartnerReward?

  @@map("partner_referrals")
}

model PartnerReward {
  id                    Int             @id @default(autoincrement())
  referralId            Int             @unique @map("referral_id")
  subscriptionPaymentId Int             @unique @map("subscription_payment_id")
  amount                Int
  plan                  String
  status                String          @default("pending")
  eligibleAt            DateTime        @map("eligible_at")
  approvedAt            DateTime?       @map("approved_at")
  paidAt                DateTime?       @map("paid_at")
  payoutReference       String?         @map("payout_reference")
  createdAt             DateTime        @default(now()) @map("created_at")
  referral              PartnerReferral @relation(fields: [referralId], references: [id], onDelete: Restrict)

  @@index([status, eligibleAt])
  @@map("partner_rewards")
}

model GrowthRewardPolicy {
  id                   Int      @id @default(1)
  artistCredit         Int      @default(100) @map("artist_credit")
  halfYearlyCommission Int      @default(75) @map("half_yearly_commission")
  annualCommission     Int      @default(150) @map("annual_commission")
  labelCommission      Int      @default(200) @map("label_commission")
  coolingDays          Int      @default(7) @map("cooling_days")
  payoutMinimum        Int      @default(500) @map("payout_minimum")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("growth_reward_policy")
}

model AcquisitionEvent {
  id          Int      @id @default(autoincrement())
  userId      Int?     @map("user_id")
  anonymousId String?  @map("anonymous_id")
  funnel      String
  event       String
  attribution Json?
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([funnel, event, createdAt])
  @@index([userId, createdAt])
  @@map("acquisition_events")
}

model ReleaseOwnershipHistory {
  id                  Int      @id @default(autoincrement())
  releaseId           Int      @map("release_id")
  previousOwnerUserId Int?     @map("previous_owner_user_id")
  newOwnerUserId      Int      @map("new_owner_user_id")
  changedByAdminId    Int?     @map("changed_by_admin_id")
  reason              String?
  createdAt           DateTime @default(now()) @map("created_at")
  release             Release  @relation(fields: [releaseId], references: [id], onDelete: Restrict)

  @@index([releaseId, createdAt])
  @@index([previousOwnerUserId])
  @@index([newOwnerUserId])
  @@map("release_ownership_history")
}

model Track {
  id                          Int                                 @id @default(autoincrement())
  releaseId                   Int                                 @map("release_id")
  title                       String
  duration                    Int?
  isrc                        String?
  distributorStatus           String?                             @map("distributor_status")
  audioUploadId               Int?                                @map("audio_upload_id")
  trackNumber                 Int?                                @map("track_number")
  audioUrl                    String?                             @map("audio_url")
  primaryArtist               String?                             @map("primary_artist")
  metadata                    Json?
  createdAt                   DateTime                            @default(now()) @map("created_at")
  release                     Release                             @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  royaltyLineItems            RoyaltyLineItem[]
  splitRecords                SplitRecord[]
  splitRecipients             SplitRecipient[]
  splitEarnings               SplitEarningLineItem[]
  unmatchedRoyaltyRows        UnmatchedRoyaltyRow[]
  reconciliationDiscrepancies DireNoteReconciliationDiscrepancy[]
  identifierHistory           ExternalIdentifierHistory[]
  storedAssets                StoredAsset[]
  audioAssetLinks             ReleaseAssetLink[]
  uploadSessions              UploadSession[]
  contributions               TrackContribution[]
  contributionSnapshots       TrackContributionSnapshot[]
  beatLinks                   ReleaseTrackBeatLink[]

  @@index([isrc])
  @@map("tracks")
}

model AdminRole {
  id          Int                   @id @default(autoincrement())
  key         String                @unique
  name        String
  description String?
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  permissions AdminRolePermission[]
  memberships AdminMembership[]

  @@map("admin_roles")
}

model AdminPermission {
  id          Int                   @id @default(autoincrement())
  key         String                @unique
  description String?
  roles       AdminRolePermission[]

  @@map("admin_permissions")
}

model AdminRolePermission {
  roleId       Int             @map("role_id")
  permissionId Int             @map("permission_id")
  role         AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("admin_role_permissions")
}

model AdminMembership {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique @map("user_id")
  roleId    Int       @map("role_id")
  active    Boolean   @default(true)
  createdBy Int?      @map("created_by")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
