generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  PRODUCER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  BANNED
}

enum ProducerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReleaseStatus {
  DRAFT
  AWAITING_PAYMENT
  SUBMITTED
  IN_QUEUE
  IN_QC_QUEUE
  UNDER_REVIEW
  CHANGES_REQUESTED
  RESUBMITTED
  APPROVED
  QUEUED_FOR_DISTRIBUTION
  SUBMITTING_TO_DISTRIBUTOR
  SENT_TO_DISTRIBUTOR
  DISTRIBUTOR_PROCESSING
  DISTRIBUTOR_CHANGES_REQUIRED
  SCHEDULED
  PROCESSING
  AWAITING_LIVE_CONFIRMATION
  PARTIALLY_LIVE
  DELIVERED
  SENT
  LIVE
  DISTRIBUTED
  REJECTED
  FAILED
  DELIVERY_FAILED
  TAKEDOWN_REQUESTED
  TAKEDOWN_PROCESSING
  TAKEN_DOWN
  ARCHIVED
}

enum ReleaseSource {
  CUSTOMER_SUBMISSION
  ADMIN_MANUAL
  DIRENOTE_SYNC
  MIGRATED
}

enum UploadKind {
  AUDIO
  ARTWORK
  BEAT
  DOCUMENT
  SAMPLE
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum PayoutStatus {
  PENDING
  APPROVED
  PAID
  FAILED
}

enum PayoutRequestMethod {
  UPI
  BANK
}

enum PayoutRequestStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  PROCESSING
  PAID
  FAILED
  REJECTED
  CANCELLED
}

model User {
  id                            Int                                 @id @default(autoincrement())
  googleId                      String                              @unique @map("google_id")
  name                          String
  email                         String                              @unique
  passwordHash                  String?                             @map("password_hash")
  avatar                        String?
  role                          UserRole                            @default(CUSTOMER)
  status                        AccountStatus                       @default(ACTIVE)
  onboardingDone                Boolean                             @default(false) @map("onboarding_done")
  mobile                        String?
  contactEmail                  String?                             @map("contact_email")
  dateOfBirth                   DateTime?                           @map("date_of_birth") @db.Date
  preferredLanguage             String                              @default("en") @map("preferred_language")
  onboardingPurpose             String?                             @map("onboarding_purpose")
  onboardingUserType            String?                             @map("onboarding_user_type")
  referralSource                String?                             @map("referral_source")
  onboardingReferralCode        String?                             @map("onboarding_referral_code")
  onboardingCompletedAt         DateTime?                           @map("onboarding_completed_at")
  onboardingPreferences         Json?                               @map("onboarding_preferences")
  referralCode                  String?                             @unique @map("referral_code")
  referralCredits               Int                                 @default(0) @map("referral_credits")
  referredById                  Int?                                @map("referred_by")
  firstPaymentRewarded          Boolean                             @default(false) @map("first_payment_rewarded")
  createdAt                     DateTime                            @default(now()) @map("created_at")
  updatedAt                     DateTime                            @updatedAt @map("updated_at")
  sessions                      Session[]
  applications                  ProducerApplication[]               @relation("ApplicantApplications")
  reviewedApps                  ProducerApplication[]               @relation("ApplicationReviewer")
  releases                      Release[]
  ownedManualReleases           Release[]                           @relation("ManualReleaseOwner")
  assignedManualReleases        Release[]                           @relation("ManualReleaseAssigner")
  uploads                       Upload[]
  royalties                     Royalty[]
  payouts                       Payout[]
  payoutRequests                PayoutRequest[]
  payoutBalance                 ArtistPayoutBalance?
  royaltyLineItems              RoyaltyLineItem[]
  notifications                 Notification[]
  emailLogs                     EmailLog[]
  supportTickets                SupportTicket[]
  auditLogs                     AuditLog[]
  subscription                  Subscription?
  referredBy                    User?                               @relation("UserReferrals", fields: [referredById], references: [id])
  referrals                     User[]                              @relation("UserReferrals")
  sentReferrals                 Referral[]                          @relation("ReferralOwner")
  receivedReferral              Referral?                           @relation("ReferralRecipient")
  creditLedgerEntries           CreditLedgerEntry[]
  referralVisits                ReferralVisit[]
  beats                         Beat[]
  producerProfile               ProducerProfile?
  artistCards                   ArtistCard[]
  ownedSplitRecords             SplitRecord[]                       @relation("SplitOwner")
  splitRecipients               SplitRecipient[]                    @relation("SplitRecipientUser")
  payoutCredential              PayoutCredential?
  splitEarnings                 SplitEarningLineItem[]
  walletTransactions            WalletTransaction[]
  producerSales                 BeatSale[]                          @relation("ProducerBeatSales")
  purchasedBeatSales            BeatSale[]                          @relation("BuyerBeatSales")
  quarterCarryForwards          QuarterCarryForward[]
  storedAssets                  StoredAsset[]
  royaltyStatements             RoyaltyStatement[]
  royaltyImportJobs             RoyaltyImportJob[]
  royaltyAllocations            RoyaltyAllocation[]
  adminMembership               AdminMembership?
  managedServiceRequests        ManagedServiceRequest[]
  distributionOrders            DistributionOrder[]
  checkoutOrders                CheckoutOrder[]
  couponRedemptions             CouponRedemption[]
  beatPurchases                 BeatPurchase[]
  financialAdjustmentSubjects   FinancialAdjustment[]               @relation("FinancialAdjustmentSubject")
  requestedFinancialAdjustments FinancialAdjustment[]               @relation("FinancialAdjustmentRequester")
  approvedFinancialAdjustments  FinancialAdjustment[]               @relation("FinancialAdjustmentApprover")
  direNoteDiscrepanciesResolved DireNoteReconciliationDiscrepancy[] @relation("DireNoteDiscrepancyResolver")
  promotionRedemptions          PromotionRedemption[]

  @@index([role])
  @@index([email])
  @@map("users")
}

model Session {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model ProducerApplication {
  id              Int                       @id @default(autoincrement())
  userId          Int                       @map("user_id")
  producerName    String                    @map("producer_name")
  genre           String
  portfolioLinks  String[]                  @default([]) @map("portfolio_links")
  instagram       String?
  youtube         String?
  soundcloud      String?
  spotify         String?
  yearsExperience Int                       @map("years_experience")
  pricing         String
  sampleBeats     String[]                  @default([]) @map("sample_beats")
  bio             String
  status          ProducerApplicationStatus @default(PENDING)
  internalNotes   String?                   @map("internal_notes")
  reviewedById    Int?                      @map("reviewed_by_id")
  reviewedAt      DateTime?                 @map("reviewed_at")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")
  user            User                      @relation("ApplicantApplications", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy      User?                     @relation("ApplicationReviewer", fields: [reviewedById], references: [id])

  @@index([status, createdAt])
  @@map("producer_applications")
}

model Release {
  id                          Int                                 @id @default(autoincrement())
  userId                      Int                                 @map("user_id")
  ownerUserId                 Int?                                @map("owner_user_id")
  artistProfileId             Int?                                @map("artist_profile_id")
  releaseSource               ReleaseSource                       @default(CUSTOMER_SUBMISSION) @map("release_source")
  customerEditable            Boolean                             @default(true) @map("customer_editable")
  assignedByAdminId           Int?                                @map("assigned_by_admin_id")
  assignedAt                  DateTime?                           @map("assigned_at")
  archivedAt                  DateTime?                           @map("archived_at")
  title                       String
  artistName                  String                              @map("artist_name")
  genre                       String
  collaborators               String[]                            @default([])
  producer                    String?
  bpm                         Int?
  explicit                    Boolean                             @default(false)
  releaseDate                 DateTime                            @map("release_date")
  status                      ReleaseStatus                       @default(DRAFT)
  distributorReleaseId        String?                             @map("distributor_release_id")
  direNoteStatus              String?                             @map("direnote_status")
  direNoteLastSyncedAt        DateTime?                           @map("direnote_last_synced_at")
  direNoteLastAttemptedAt     DateTime?                           @map("direnote_last_attempted_at")
  direNoteSyncError           String?                             @map("direnote_sync_error")
  upc                         String?                             @map("upc_code")
  rejectionReason             String?                             @map("rejection_reason")
  correctionReason            String?                             @map("correction_reason")
  reviewIssues                Json?                               @map("review_issues")
  adminInternalNote           String?                             @map("admin_internal_note")
  reviewedAt                  DateTime?                           @map("reviewed_at")
  reviewedBy                  String?                             @map("reviewed_by")
  releaseType                 String?                             @map("release_type")
  artworkUrl                  String?                             @map("artwork_url")
  audioUrl                    String?                             @map("audio_url")
  paymentStatus               String?                             @default("pending") @map("payment_status")
  metadata                    Json?
  draftCompletionPercent      Int                                 @default(0) @map("draft_completion_percent")
  lastEditedAt                DateTime?                           @map("last_edited_at")
  missingFields               Json?                               @map("missing_fields")
  createdAt                   DateTime                            @default(now()) @map("created_at")
  updatedAt                   DateTime                            @updatedAt @map("updated_at")
  version                     Int                                 @default(1)
  user                        User                                @relation(fields: [userId], references: [id], onDelete: Cascade)
  owner                       User?                               @relation("ManualReleaseOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  artistProfile               ArtistCard?                         @relation(fields: [artistProfileId], references: [id], onDelete: SetNull)
  assignedByAdmin             User?                               @relation("ManualReleaseAssigner", fields: [assignedByAdminId], references: [id], onDelete: SetNull)
  ownershipHistory            ReleaseOwnershipHistory[]
  tracks                      Track[]
  uploads                     Upload[]
  analytics                   Analytics[]
  royalties                   Royalty[]
  royaltyLineItems            RoyaltyLineItem[]
  distributionQueueEntry      DistributionQueueEntry?
  splitRecords                SplitRecord[]
  splitRecipients             SplitRecipient[]
  splitEarnings               SplitEarningLineItem[]
  direNoteLogs                DireNoteLog[]
  storedAssets                StoredAsset[]
  statusTransitions           ReleaseStatusTransition[]
  distributionSubmissions     DistributionSubmissionAttempt[]
  changeRequests              ReleaseChangeRequest[]
  managedServiceRequests      ManagedServiceRequest[]
  unmatchedRoyaltyRows        UnmatchedRoyaltyRow[]
  reconciliationDiscrepancies DireNoteReconciliationDiscrepancy[]
  promotionRedemptions        PromotionRedemption[]
  subscriptionUsage           SubscriptionReleaseUsage?
  identifierHistory           ExternalIdentifierHistory[]

  @@index([ownerUserId, status])
  @@index([releaseSource, archivedAt, createdAt])
  @@index([artistProfileId])
  @@index([status, createdAt])
  @@index([distributorReleaseId])
  @@index([upc])
  @@map("releases")
}

model Promotion {
  id             Int                   @id @default(autoincrement())
  code           String                @unique
  name           String
  product        String
  discountType   String                @map("discount_type")
  discountValue  Decimal               @map("discount_value") @db.Decimal(12, 2)
  active         Boolean               @default(true)
  startsAt       DateTime?             @map("starts_at")
  endsAt         DateTime?             @map("ends_at")
  maxRedemptions Int?                  @map("max_redemptions")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  redemptions    PromotionRedemption[]

  @@map("promotions")
}

model PromotionRedemption {
  id             Int       @id @default(autoincrement())
  promotionId    Int       @map("promotion_id")
  userId         Int       @map("user_id")
  releaseId      Int?      @map("release_id")
  originalAmount Decimal   @map("original_amount") @db.Decimal(12, 2)
  discountAmount Decimal   @map("discount_amount") @db.Decimal(12, 2)
  finalAmount    Decimal   @map("final_amount") @db.Decimal(12, 2)
  currency       String    @default("INR")
  status         String    @default("RESERVED")
  campaignSource Json?     @map("campaign_source")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  redeemedAt     DateTime? @map("redeemed_at")
  promotion      Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  user           User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  release        Release?  @relation(fields: [releaseId], references: [id], onDelete: Restrict)

  @@unique([promotionId, userId])
  @@index([status, createdAt])
  @@index([releaseId])
  @@map("promotion_redemptions")
}

model AcquisitionEvent {
  id          Int      @id @default(autoincrement())
  userId      Int?     @map("user_id")
  anonymousId String?  @map("anonymous_id")
  funnel      String
  event       String
  attribution Json?
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([funnel, event, createdAt])
  @@index([userId, createdAt])
  @@map("acquisition_events")
}

model ReleaseOwnershipHistory {
  id                  Int      @id @default(autoincrement())
  releaseId           Int      @map("release_id")
  previousOwnerUserId Int?     @map("previous_owner_user_id")
  newOwnerUserId      Int      @map("new_owner_user_id")
  changedByAdminId    Int?     @map("changed_by_admin_id")
  reason              String?
  createdAt           DateTime @default(now()) @map("created_at")
  release             Release  @relation(fields: [releaseId], references: [id], onDelete: Restrict)

  @@index([releaseId, createdAt])
  @@index([previousOwnerUserId])
  @@index([newOwnerUserId])
  @@map("release_ownership_history")
}

model Track {
  id                          Int                                 @id @default(autoincrement())
  releaseId                   Int                                 @map("release_id")
  title                       String
  duration                    Int?
  isrc                        String?
  distributorStatus           String?                             @map("distributor_status")
  audioUploadId               Int?                                @map("audio_upload_id")
  trackNumber                 Int?                                @map("track_number")
  audioUrl                    String?                             @map("audio_url")
  primaryArtist               String?                             @map("primary_artist")
  metadata                    Json?
  createdAt                   DateTime                            @default(now()) @map("created_at")
  release                     Release                             @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  royaltyLineItems            RoyaltyLineItem[]
  splitRecords                SplitRecord[]
  splitRecipients             SplitRecipient[]
  splitEarnings               SplitEarningLineItem[]
  unmatchedRoyaltyRows        UnmatchedRoyaltyRow[]
  reconciliationDiscrepancies DireNoteReconciliationDiscrepancy[]
  identifierHistory           ExternalIdentifierHistory[]

  @@index([isrc])
  @@map("tracks")
}

model AdminRole {
  id          Int                   @id @default(autoincrement())
  key         String                @unique
  name        String
  description String?
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  permissions AdminRolePermission[]
  memberships AdminMembership[]

  @@map("admin_roles")
}

model AdminPermission {
  id          Int                   @id @default(autoincrement())
  key         String                @unique
  description String?
  roles       AdminRolePermission[]

  @@map("admin_permissions")
}

model AdminRolePermission {
  roleId       Int             @map("role_id")
  permissionId Int             @map("permission_id")
  role         AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("admin_role_permissions")
}

model AdminMembership {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique @map("user_id")
  roleId    Int       @map("role_id")
  active    Boolean   @default(true)
  createdBy Int?      @map("created_by")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  role      AdminRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([roleId, active])
  @@map("admin_memberships")
}

model ReleaseStatusTransition {
  id             Int           @id @default(autoincrement())
  releaseId      Int           @map("release_id")
  previousStatus ReleaseStatus @map("previous_status")
  newStatus      ReleaseStatus @map("new_status")
  actorId        Int?          @map("actor_id")
  actorType      String        @map("actor_type")
  reason         String?
  requestId      String?       @map("request_id")
  metadata       Json?
  createdAt      DateTime      @default(now()) @map("created_at")
  release        Release       @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([releaseId, createdAt])
  @@map("release_status_transitions")
}

model DistributionSubmissionAttempt {
  id                Int       @id @default(autoincrement())
  releaseId         Int       @map("release_id")
  provider          String    @default("direnote")
  idempotencyKey    String    @unique @map("idempotency_key")
  payloadHash       String    @map("payload_hash")
  state             String    @default("processing")
  attemptCount      Int       @default(1) @map("attempt_count")
  providerReference String?   @map("provider_reference")
  httpStatus        Int?      @map("http_status")
  safeError         String?   @map("safe_error")
  responseRedacted  Json?     @map("response_redacted")
  startedAt         DateTime  @default(now()) @map("started_at")
  completedAt       DateTime? @map("completed_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  release           Release   @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([releaseId, state, updatedAt])
  @@index([provider, state, updatedAt])
  @@map("distribution_submission_attempts")
}

model ReleaseChangeRequest {
  id                 Int                         @id @default(autoincrement())
  releaseId          Int                         @map("release_id")
  requestedByUserId  Int                         @map("requested_by_user_id")
  requestType        String                      @map("request_type")
  status             String                      @default("submitted")
  reason             String
  desiredEffectiveAt DateTime?                   @map("desired_effective_at")
  requestedChanges   Json?                       @map("requested_changes")
  providerReference  String?                     @map("provider_reference")
  adminNote          String?                     @map("admin_note")
  reviewedByAdminId  Int?                        @map("reviewed_by_admin_id")
  submittedAt        DateTime                    @default(now()) @map("submitted_at")
  reviewedAt         DateTime?                   @map("reviewed_at")
  completedAt        DateTime?                   @map("completed_at")
  updatedAt          DateTime                    @updatedAt @map("updated_at")
  release            Release                     @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  events             ReleaseChangeRequestEvent[]

  @@index([releaseId, requestType, status])
  @@index([status, submittedAt])
  @@map("release_change_requests")
}

model ReleaseChangeRequestEvent {
  id                Int                  @id @default(autoincrement())
  requestId         Int                  @map("request_id")
  actorType         String               @map("actor_type")
  actorId           Int?                 @map("actor_id")
  previousStatus    String?              @map("previous_status")
  newStatus         String               @map("new_status")
  note              String
  providerReference String?              @map("provider_reference")
  metadata          Json?
  createdAt         DateTime             @default(now()) @map("created_at")
  request           ReleaseChangeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("release_change_request_events")
}

model ManagedServiceRequest {
  id                 Int                            @id @default(autoincrement())
  userId             Int                            @map("user_id")
  releaseId          Int                            @map("release_id")
  trackId            Int?                           @map("track_id")
  serviceType        String                         @map("service_type")
  provider           String?
  status             String                         @default("submitted")
  eligibilityAnswers Json                           @map("eligibility_answers")
  declarations       Json?
  publicLinks        Json?                          @map("public_links")
  riskFlags          Json?                          @map("risk_flags")
  internalNotes      String?                        @map("internal_notes")
  userVisibleUpdate  String?                        @map("user_visible_update")
  assignedAdminId    Int?                           @map("assigned_admin_id")
  externalReference  String?                        @map("external_reference")
  rejectionReason    String?                        @map("rejection_reason")
  idempotencyKey     String                         @unique @map("idempotency_key")
  submittedAt        DateTime                       @default(now()) @map("submitted_at")
  reviewedAt         DateTime?                      @map("reviewed_at")
  completedAt        DateTime?                      @map("completed_at")
  updatedAt          DateTime                       @updatedAt @map("updated_at")
  user               User                           @relation(fields: [userId], references: [id], onDelete: Restrict)
  release            Release                        @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  documents          ManagedServiceDocument[]
  providerStatuses   ManagedServiceProviderStatus[]

  @@index([userId, serviceType, submittedAt])
  @@index([serviceType, status, submittedAt])
  @@index([releaseId, trackId])
  @@map("managed_service_requests")
}

model ManagedServiceProviderStatus {
  id        Int                   @id @default(autoincrement())
  requestId Int                   @map("request_id")
  provider  String
  status    String
  reference String?
  note      String?
  updatedAt DateTime              @updatedAt @map("updated_at")
  request   ManagedServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, provider])
  @@index([status, updatedAt])
  @@map("managed_service_provider_statuses")
}

model ManagedServiceDocument {
  requestId Int                   @map("request_id")
  assetId   Int                   @map("asset_id")
  request   ManagedServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  asset     StoredAsset           @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([requestId, assetId])
  @@index([assetId])
  @@map("managed_service_documents")
}

model SpotifyAdminConnection {
  id            Int      @id
  spotifyUserId String   @map("spotify_user_id")
  displayName   String   @map("display_name")
  refreshToken  String   @map("refresh_token")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("spotify_admin_connections")
}

model DireNoteLog {
  id                     Int      @id @default(autoincrement())
  releaseId              Int?     @map("release_id")
  action                 String
  httpStatus             Int?     @map("http_status")
  success                Boolean
  requestPayloadRedacted Json?    @map("request_payload_redacted")
  responseRaw            String?  @map("response_raw") @db.Text
  responseJson           Json?    @map("response_json")
  errorMessage           String?  @map("error_message") @db.Text
  createdAt              DateTime @default(now()) @map("created_at")
  createdByAdminId       Int?     @map("created_by_admin_id")
  release                Release? @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([releaseId, createdAt])
  @@index([action, createdAt])
  @@map("direnote_logs")
}

model AdminTask {
  id             Int       @id @default(autoincrement())
  eventKey       String    @unique @map("event_key")
  type           String
  priority       String    @default("normal")
  title          String
  body           String
  href           String
  entityType     String    @map("entity_type")
  entityId       String    @map("entity_id")
  status         String    @default("open")
  assignedTo     Int?      @map("assigned_to")
  resolutionNote String?   @map("resolution_note")
  snoozedUntil   DateTime? @map("snoozed_until")
  resolvedAt     DateTime? @map("resolved_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status, priority, createdAt])
  @@index([entityType, entityId])
  @@map("admin_tasks")
}

model AdminTaskHistory {
  id        Int      @id @default(autoincrement())
  taskId    Int      @map("task_id")
  actorId   Int?     @map("actor_id")
  action    String
  note      String?
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([taskId, createdAt])
  @@map("admin_task_history")
}

model Upload {
  id           Int        @id @default(autoincrement())
  userId       Int        @map("user_id")
  releaseId    Int?       @map("release_id")
  kind         UploadKind
  storageKey   String     @map("storage_key")
  fileName     String     @map("file_name")
  mimeType     String     @map("mime_type")
  sizeBytes    Int        @map("size_bytes")
  checksum     String?
  publicUrl    String?    @map("public_url")
  createdAt    DateTime   @default(now()) @map("created_at")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  release      Release?   @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  audioBeats   Beat[]     @relation("BeatAudio")
