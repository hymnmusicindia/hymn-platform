}

model DistributionQueueEntry {
  id                Int                    @id @default(autoincrement())
  releaseId         Int                    @unique @map("release_id")
  currentStage      String                 @map("current_stage")
  qualityCheckNotes String?                @map("quality_check_notes")
  approvalNotes     String?                @map("approval_notes")
  direnoteRequestId String?                @map("direnote_request_id")
  direnoteResponse  Json?                  @map("direnote_response")
  submissionId      String?                @map("submission_id")
  apiErrorMessage   String?                @map("api_error_message")
  stageHistory      Json?                  @map("stage_history")
  timestamps        Json?
  operatorId        Int?                   @map("operator_id")
  createdAt         DateTime               @default(now()) @map("created_at")
