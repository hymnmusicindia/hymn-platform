model ArtistCard {
  id                   Int                         @id @default(autoincrement())
  userId               Int                         @map("user_id")
  artistName           String                      @map("artist_name")
  spotifyProfileUrl    String?                     @map("spotify_profile_url")
  spotifyArtistId      String?                     @map("spotify_artist_id")
  appleMusicProfileUrl String?                     @map("apple_music_profile_url")
  appleArtistId        String?                     @map("apple_artist_id")
  instagramUrl         String?                     @map("instagram_url")
  youtubeUrl           String?                     @map("youtube_url")
  imageUrl             String?                     @map("image_url")
  followers            Int?
  isPrimary            Boolean                     @default(false) @map("is_primary")
  archivedAt           DateTime?                   @map("archived_at")
  role                 String?
  direNoteArtistId     String?                     @map("direnote_artist_id")
  direNoteLastSyncedAt DateTime?                   @map("direnote_last_synced_at")
  createdAt            DateTime                    @default(now()) @map("created_at")
  updatedAt            DateTime                    @updatedAt @map("updated_at")
  user                 User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  releases             Release[]
  identifierHistory    ExternalIdentifierHistory[]

  @@unique([userId, artistName])
  @@index([userId])
  @@map("artist_cards")
}

model DireNoteReconciliationDiscrepancy {
  id            Int       @id @default(autoincrement())
  releaseId     Int       @map("release_id")
  trackId       Int?      @map("track_id")
  field         String
  hymnValue     Json?     @map("hymn_value")
  direNoteValue Json?     @map("direnote_value")
  severity      String    @default("warning")
  status        String    @default("open")
  detectedAt    DateTime  @default(now()) @map("detected_at")
  resolvedAt    DateTime? @map("resolved_at")
  resolvedById  Int?      @map("resolved_by_id")
  resolution    String?
  release       Release   @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  track         Track?    @relation(fields: [trackId], references: [id], onDelete: SetNull)
  resolvedBy    User?     @relation("DireNoteDiscrepancyResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([releaseId, status, detectedAt])
  @@index([status, severity, detectedAt])
  @@map("direnote_reconciliation_discrepancies")
}

model ExternalIdentifierHistory {
  id             Int         @id @default(autoincrement())
  releaseId      Int?        @map("release_id")
  trackId        Int?        @map("track_id")
  artistCardId   Int?        @map("artist_card_id")
  provider       String
  identifierType String      @map("identifier_type")
  previousValue  String?     @map("previous_value")
  canonicalValue String      @map("canonical_value")
  source         String
  reason         String?
  createdAt      DateTime    @default(now()) @map("created_at")
  release        Release?    @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  track          Track?      @relation(fields: [trackId], references: [id], onDelete: Cascade)
  artistCard     ArtistCard? @relation(fields: [artistCardId], references: [id], onDelete: Cascade)

  @@index([releaseId, identifierType, createdAt])
  @@index([trackId, identifierType, createdAt])
  @@map("external_identifier_history")
}

model BeatPurchase {
  id                   Int       @id @default(autoincrement())
  userId               Int       @map("user_id")
  beatId               Int       @map("beat_id")
  licenseType          String    @map("license_type")
  purchasedAt          DateTime  @default(now()) @map("purchased_at")
  licenseUploadedAt    DateTime? @map("license_uploaded_at")
  licenseUrl           String?   @map("license_url")
  releaseId            Int?      @unique @map("release_id")
  paymentId            String?   @map("payment_id")
  checkoutOrderItemId  Int?      @unique @map("checkout_order_item_id")
  hasAccess            Boolean   @default(true) @map("has_access")
  licenseVersion       String?   @map("license_version")
  licenseTermsSnapshot Json?     @map("license_terms_snapshot")
  downloadedAt         DateTime? @map("downloaded_at")
  downloadCount        Int       @default(0) @map("download_count")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
