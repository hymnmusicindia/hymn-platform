  @@index([paymentStatus, createdAt])
  @@map("checkout_orders")
}

model CheckoutOrderItem {
  id          Int           @id @default(autoincrement())
  orderId     Int           @map("order_id")
  beatId      Int           @map("beat_id")
  licenseType String        @map("license_type")
  price       Decimal       @db.Decimal(12, 2)
  licenseUrl  String?       @map("license_url")
  createdAt   DateTime      @default(now()) @map("created_at")
  order       CheckoutOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  beat        Beat          @relation(fields: [beatId], references: [id], onDelete: Restrict)
  purchase    BeatPurchase?

  @@unique([orderId, beatId, licenseType])
  @@index([beatId, createdAt])
  @@map("checkout_order_items")
}

model CouponRedemption {
  id        Int           @id @default(autoincrement())
  couponId  Int           @map("coupon_id")
  userId    Int           @map("user_id")
  orderId   Int           @unique @map("order_id")
  createdAt DateTime      @default(now()) @map("created_at")
  coupon    Coupon        @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  order     CheckoutOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

model DistributionOrder {
  id                Int                   @id @default(autoincrement())
  userId            Int                   @map("user_id")
  plan              String
  amount            Int
  razorpayOrderId   String                @unique @map("razorpay_order_id")
  razorpayPaymentId String?               @unique @map("razorpay_payment_id")
  paymentStatus     String                @default("created") @map("payment_status")
  currency          String                @default("INR")
  fulfilledAt       DateTime?             @map("fulfilled_at")
  webhookEvents     PaymentWebhookEvent[]
  user              User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt         DateTime              @default(now()) @map("created_at")

  @@index([userId, paymentStatus])
  @@map("distribution_orders")
}

model PaymentWebhookEvent {
  id                     Int                @id @default(autoincrement())
  provider               String             @default("razorpay")
  providerEventId        String?            @unique @map("provider_event_id")
  eventType              String             @map("event_type")
  payloadHash            String             @unique @map("payload_hash")
  signatureValid         Boolean            @map("signature_valid")
  processingState        String             @default("received") @map("processing_state")
  attemptCount           Int                @default(0) @map("attempt_count")
  distributionOrderId    Int?               @map("distribution_order_id")
  checkoutOrderId        Int?               @map("checkout_order_id")
  razorpayOrderId        String?            @map("razorpay_order_id")
  razorpaySubscriptionId String?            @map("razorpay_subscription_id")
  paymentId              String?            @map("payment_id")
  amountMinor            Int?               @map("amount_minor")
  currency               String?
  errorCode              String?            @map("error_code")
  errorMessage           String?            @map("error_message")
  payloadRedacted        Json?              @map("payload_redacted")
  receivedAt             DateTime           @default(now()) @map("received_at")
  processedAt            DateTime?          @map("processed_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")
  distributionOrder      DistributionOrder? @relation(fields: [distributionOrderId], references: [id], onDelete: SetNull)
  checkoutOrder          CheckoutOrder?     @relation(fields: [checkoutOrderId], references: [id], onDelete: SetNull)

  @@index([processingState, receivedAt])
  @@index([razorpayOrderId])
  @@index([razorpaySubscriptionId])
  @@index([checkoutOrderId])
  @@map("payment_webhook_events")
}

