  metadata       Json?
  createdAt      DateTime               @default(now()) @map("created_at")
  queueEntry     DistributionQueueEntry @relation(fields: [queueEntryId], references: [id], onDelete: Cascade)

  @@index([queueEntryId, stageStartTime])
  @@map("distribution_queue_logs")
}

