model Beat {
  id              Int         @id @default(autoincrement())
  userId          Int         @map("user_id")
  title           String
  bpm             Int
  genre           String
  mood            String
  keySignature    String      @map("key_signature")
  priceCents      Int         @map("price_cents")
  audioUploadId   Int?        @map("audio_upload_id")
  artworkUploadId Int?        @map("artwork_upload_id")
  enabled         Boolean     @default(true)
  status          String      @default("PENDING_REVIEW")
  reviewIssues    Json?       @map("review_issues")
  sortOrder       Int         @default(0) @map("sort_order")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  audio           Upload?     @relation("BeatAudio", fields: [audioUploadId], references: [id])
  artwork         Upload?     @relation("BeatArtwork", fields: [artworkUploadId], references: [id])

  @@index([userId, enabled])
  @@index([genre, mood])
  @@map("beats")
}

